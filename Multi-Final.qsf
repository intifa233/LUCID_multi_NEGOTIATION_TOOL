      "SecondaryAttribute": null,
      "TertiaryAttribute": null,
      "Payload": {
        "Notes": [
          {
            "Message": "Current Thoughts Scale (Heatherton & Polivy, 1991) \u2013 A measure of state self-esteem\nItems 2, 4, 5, 7, 8, 10, 13, 15, 16, 17, 18, 19, 20 are reverse-scored.  \nSum scores from all items and keep scale as a continuous measure of state self esteem.\n The subcomponents are scored as follows: \nPerformance Self-esteem items: 1, 4, 5, 9, 14, 18, 19. \nSocial Self-esteem items: 2, 8, 10, 13, 15, 17, 20.\nAppearance Self-esteem items: 3, 6, 7, 11, 12, 16.",
            "ID": "NO_dmR0Tweu23MLZR4",
            "UserID": "UR_cSHQHzrLYkXbsvW",
            "Timestamp": 1734806786,
            "Removed": false
          }
        ],

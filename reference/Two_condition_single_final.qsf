      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<div id=\"chat-container\" style=\"position: relative; display: flex; flex-direction: column; width: 98%; height: 650px; margin: 0 auto; padding: 15px; background-color: white; border-radius: 10px; box-sizing: border-box; gap: 15px;\"><div id=\"round-countdown-badge\" style=\"position: absolute; top: 10px; left: 10px; z-index: 20; background-color: #e3f2fd; border: 1px solid #90caf9; color: #0066cc; padding: 6px 14px; border-radius: 999px; font-size: 13px; font-weight: bold; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(0,0,0,0.15);\"><span style=\"font-size: 15px; line-height: 1;\">&#9203;</span><span><span id=\"round-countdown-number\">10</span> rounds left</span></div>\n<div style=\"display: flex; gap: 15px; flex: 1; min-height: 0; margin-top: 35px;\">\n<div id=\"message-container\" style=\"flex: 1; overflow-y: auto; overflow-x: hidden; padding: 10px; box-sizing: border-box;\">&nbsp;</div>\n<div id=\"offers-sidebar\" style=\"width: 280px; overflow-y: auto; box-sizing: border-box;\">\n<div id=\"offers-panel\" style=\"display:block;\">\n<div style=\"font-weight: bold; margin-bottom: 10px;\">\ud83d\udcca Current Offers</div>\n<div style=\"display: flex; flex-direction: column; gap: 10px;\">\n<div style=\"padding: 10px; background-color: #e3f2fd; border: 1px solid #90caf9; border-radius: 5px;\">\n<div style=\"color: #0066cc; font-weight: bold; margin-bottom: 5px;\">Your Offer</div>\n<div id=\"user-offer-content\" style=\"background-color: #fff; padding: 8px; border-radius: 3px; font-size: 14px;\">\n<span style=\"color: #999; font-style: italic;\">No offer yet</span>\n</div>\n</div>\n<div style=\"padding: 10px; background-color: #ffebee; border: 1px solid #ef9a9a; border-radius: 5px;\">\n<div style=\"color: #d9534f; font-weight: bold; margin-bottom: 5px;\">AI Offer</div>\n<div id=\"ai-offer-content\" style=\"background-color: #fff; padding: 8px; border-radius: 3px; font-size: 14px;\">\n<span style=\"color: #999; font-style: italic;\">No offer yet</span>\n</div>\n</div>\n</div>\n</div>\n<div style=\"margin-top: 15px;\">\n<div id=\"item-details-header\" style=\"font-weight: bold; margin-bottom: 10px; cursor: pointer; user-select: none; color: #333;\">\u25b6 \ud83d\udce6 Item Details</div>\n<div id=\"item-details-content\" style=\"padding: 10px; background-color: #f5f5f5; border: 1px solid #d0d0d0; border-radius: 5px; display: none;\"><div style=\"background-color: #fff; padding: 8px; border-radius: 3px; font-size: 14px;\"><div><strong>Item:</strong> Apple MacBook Air</div>\n<div><strong>Storage:</strong> 128 GB</div>\n<div><strong>Processor:</strong> M1 Chip</div>\n<div><strong>Purchase Date:</strong> April of the previous year</div>\n<div><strong>Purchase Price:</strong> $799</div>\n<div><strong>Condition:</strong> Excellent, no damage</div>\n<div><strong>Warranty:</strong> One year remaining</div>\n<div><strong>Battery Health:</strong> 90%</div>\n<div><strong>Accessories:</strong> Original charger, cables, and the original box</div>\n<div><strong>Water Exposure:</strong> None</div>\n<div><strong>Apple Cloud Lock:</strong> None</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n\n<form id=\"chat-form\"><textarea rows=\"2\" placeholder=\"Type your message...\" maxlength=\"1024\" id=\"message-input\"></textarea><button type=\"submit\" class=\"sbutton\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1.5em\" viewBox=\"0 0 24 24\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke=\"currentColor\" height=\"1.5em\" fill=\"none\"><polyline points=\"18 15 12 9 6 15\"></polyline></svg></button></form>\n</div>",
        "DefaultChoices": false,
        "DataExportTag": "LUCID_TOOL",
        "QuestionID": "QID106",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
